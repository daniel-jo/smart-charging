# dryrun_prices.json — price fixture template for dryrun.py
#
# Copy to `dryrun_prices.json` and edit (or generate with
# `python3 dryrun.py --sample`). `dryrun_prices.json` is gitignored.
# "start" is an ISO datetime (on the hour), "sek_kwh" is the end-user
# price per kWh in your currency.
{
  "hours": [
    {"start": "2026-09-23T22:00:00+00:00", "sek_kwh": 0.50},
    {"start": "2026-09-23T23:00:00+00:00", "sek_kwh": 0.55},
    {"start": "2026-09-24T00:00:00+00:00", "sek_kwh": 0.60},
    {"start": "2026-09-24T01:00:00+00:00", "sek_kwh": 0.90}
  ]
}